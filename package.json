{
  "name": "podtui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PODTUI_SOCKET=/tmp/podtui-dev/podman.sock bun run src/index.tsx",
    "check": "scripts/check.sh",
    "test": "scripts/check.sh test",
    "build": "bun build --compile src/index.tsx --outfile dist/podtui",
    "lint": "bunx eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.3.0",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.11.0",
    "ink-testing-library": "4.0.0",
    "react-devtools-core": "6.1.2",
    "typescript-eslint": "8.71.0"
  }
}
